{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Alur penyelesaian transaksi SLA",
    "quality_profile": "showcase",
    "viewBox": [1500, 896]
  },
  "lanes": [
    { "id": "main", "label": "Alur transaksi" },
    { "id": "exception", "label": "Dispute", "variant": "exception" }
  ],
  "nodes": [
    { "id": "start", "lane": "main", "col": 0, "width": 120, "type": "external", "label": "Transaksi dibuat" },
    { "id": "payment", "lane": "main", "col": 1, "width": 150, "type": "security", "label": "Pembayaran" },
    { "id": "method", "lane": "main", "col": 2, "width": 140, "type": "frontend", "label": "Pilih metode" },
    { "id": "cod", "lane": "main", "col": 3, "width": 140, "type": "external", "label": "COD selesai", "yOffset": -42 },
    { "id": "shipment", "lane": "main", "col": 3, "width": 140, "type": "external", "label": "Kirim + resi", "yOffset": 42 },
    { "id": "received", "lane": "main", "col": 4, "width": 140, "type": "frontend", "label": "Paket diterima", "yOffset": 42 },
    { "id": "confirm", "lane": "main", "col": 4, "width": 150, "type": "backend", "label": "Konfirmasi", "yOffset": -42 },
    { "id": "dispute", "lane": "exception", "col": 4, "width": 150, "type": "security", "label": "Komplain", "yOffset": 130 },
    { "id": "payout", "lane": "main", "col": 5, "width": 140, "type": "external", "label": "Payout seller", "yOffset": -42 },
    { "id": "refund", "lane": "exception", "col": 5, "width": 140, "type": "security", "label": "Refund", "yOffset": 130 }
  ],
  "edges": [
    { "id": "start-payment", "from": "start", "to": "payment", "role": "main" },
    { "id": "payment-method", "from": "payment", "to": "method", "label": "Berhasil / retry jika gagal", "role": "main" },
    { "id": "method-cod", "from": "method", "to": "cod", "label": "COD", "role": "branch" },
    { "id": "method-shipment", "from": "method", "to": "shipment", "label": "Pengiriman: pembayaran penuh", "role": "branch" },
    { "id": "cod-confirm", "from": "cod", "to": "confirm", "label": "Konfirmasi / auto-release", "role": "main" },
    { "id": "shipment-received", "from": "shipment", "to": "received", "label": "Resi valid", "role": "main" },
    { "id": "received-confirm", "from": "received", "to": "confirm", "label": "Sesuai / auto-release", "role": "main" },
    { "id": "received-dispute", "from": "received", "to": "dispute", "label": "Tidak sesuai", "role": "error" },
    { "id": "confirm-payout", "from": "confirm", "to": "payout", "label": "Transaksi selesai", "role": "main" },
    { "id": "dispute-refund", "from": "dispute", "to": "refund", "label": "Seller/platform salah", "role": "error" }
  ],
  "mainPath": ["start", "payment", "method", "shipment", "received", "confirm", "payout"]
}
